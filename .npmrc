# Hoist @arcjet/* packages so the @arcjet/astro virtual module can resolve them
# at build time. The integration inlines internal.js as a virtual module string,
# which loses its node_modules context under pnpm's strict resolution.
# https://pnpm.io/npmrc#hoist-pattern
public-hoist-pattern[]=@arcjet/*
public-hoist-pattern[]=arcjet
