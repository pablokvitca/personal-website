# PostHog Analytics
# Get your key from https://app.posthog.com/project/settings
PUBLIC_POSTHOG_KEY=phc_your_key_here

# Google Analytics
# Get your Measurement ID from https://analytics.google.com (format: G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Arcjet Security
# Get your key from https://app.arcjet.com
ARCJET_KEY=ajkey_your_key_here
