{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pablokvitca-website",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    // Serve the prerendered dist/client/404.html for paths with no matching asset. Browser
    // navigations to missing paths then never invoke the Worker (compatibility_date >= 2025-04-01).
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
