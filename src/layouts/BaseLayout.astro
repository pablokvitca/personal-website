---
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import SEOHead from '@/components/common/SEOHead.astro';
import PostHog from '@/components/analytics/PostHog.astro';
import GoogleAnalytics from '@/components/analytics/GoogleAnalytics.astro';
import CookieConsent from '@/components/analytics/CookieConsent.astro';
import { Toaster } from '@/components/ui/starwind/toast';
import '@/styles/starwind.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
}

const { title, description, ogImage, article } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      article={article}
    />
    <script is:inline>
      // Parse and store ref/UTM tracking params early (before GA config fires)
      (function () {
        const SESSION_KEY = 'tracking-params';
        const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
        try {
          const search = new URLSearchParams(window.location.search);
          let stored = {};
          try {
            const raw = sessionStorage.getItem(SESSION_KEY);
            if (raw) {
              const parsed = JSON.parse(raw);
              if (parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)) {
                stored = parsed;
              }
            }
          } catch {
            // Corrupt or unavailable sessionStorage: start from empty params.
          }
          const merged = Object.assign({}, stored);
          const ref = search.get('ref');
          if (ref) merged.ref = ref;
          for (let i = 0; i < UTM_KEYS.length; i++) {
            const val = search.get(UTM_KEYS[i]);
            if (val) merged[UTM_KEYS[i]] = val;
          }
          sessionStorage.setItem(SESSION_KEY, JSON.stringify(merged));
        } catch {
          // Tracking params are best-effort; never break page load.
        }
      })();
    </script>
    <GoogleAnalytics />
    <script is:inline>
      // Prevent flash of wrong theme
      (function() {
        const theme = localStorage.getItem('theme') || 'system';
        if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <PostHog />
    <CookieConsent />
    <Header />
    <main class="container mx-auto px-4 py-8">
      <slot />
    </main>
    <Footer />
    <Toaster />
  </body>
</html>
