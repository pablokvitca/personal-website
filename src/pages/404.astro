---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Prerendered so missing paths are served as a static asset (assets.not_found_handling in
// wrangler.jsonc) instead of being server-rendered by the Worker on every miss.
export const prerender = true;
---

<BaseLayout
  title="Page not found - Pablo Kvitca"
  description="The page you were looking for does not exist."
>
  <div class="max-w-3xl mx-auto text-center py-16">
    <p class="text-sm font-semibold text-muted-foreground">404</p>
    <h1 class="text-4xl font-bold mt-2 mb-4">Page not found</h1>
    <p class="text-muted-foreground mb-8">
      The page you were looking for doesn't exist or has moved.
    </p>
    <a href="/" class="underline underline-offset-4 hover:text-primary">Back to the homepage</a>
  </div>
</BaseLayout>
