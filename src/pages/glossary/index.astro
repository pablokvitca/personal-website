---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GlossaryList from '@/components/glossary/GlossaryList.astro';
import { getAllGlossaryEntries } from '@/lib/glossary';

export const prerender = true;

const entries = await getAllGlossaryEntries();
---

<BaseLayout
  title="Glossary - Pablo Kvitca"
  description="Definitions of key concepts used across blog posts and projects."
>
  <div class="max-w-4xl mx-auto">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4">Glossary</h1>
      <p class="text-xl text-muted-foreground">
        Definitions of key concepts referenced across blog posts and projects.
      </p>
    </header>

    <GlossaryList entries={entries} />
  </div>
</BaseLayout>
