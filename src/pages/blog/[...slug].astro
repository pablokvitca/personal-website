---
import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import H1 from '@/components/ui/headings/H1.astro';
import H2 from '@/components/ui/headings/H2.astro';
import H3 from '@/components/ui/headings/H3.astro';
import H4 from '@/components/ui/headings/H4.astro';
import H5 from '@/components/ui/headings/H5.astro';
import H6 from '@/components/ui/headings/H6.astro';
import { getCollection, render } from 'astro:content';
import { getSlugFromId, getBlogSnapshots, isLiveEntry } from '@/lib/blog';

export const prerender = true;

export async function getStaticPaths() {
  const allEntries = await getCollection('blog', ({ data }) => !data.draft);

  // Separate live entries and snapshot entries
  const liveEntries = allEntries.filter(isLiveEntry);
  const snapshotEntries = allEntries.filter((e) => !isLiveEntry(e));

  // Group snapshots by slug
  const snapshotsBySlug = new Map<string, typeof snapshotEntries>();
  for (const snapshot of snapshotEntries) {
    const slug = getSlugFromId(snapshot.id);
    if (!snapshotsBySlug.has(slug)) {
      snapshotsBySlug.set(slug, []);
    }
    snapshotsBySlug.get(slug)!.push(snapshot);
  }

  const paths = [];

  // Generate paths for live versions
  for (const liveEntry of liveEntries) {
    const slug = getSlugFromId(liveEntry.id);
    paths.push({
      params: { slug },
      props: { post: liveEntry, isSnapshot: false },
    });

    // Generate paths for historical snapshots (all except the most recent)
    const slugSnapshots = snapshotsBySlug.get(slug) ?? [];
    if (slugSnapshots.length > 1) {
      const sorted = slugSnapshots.sort(
        (a, b) =>
          new Date(b.data.snapshotDate ?? 0).getTime() -
          new Date(a.data.snapshotDate ?? 0).getTime()
      );

      // Skip the most recent snapshot (index 0), generate routes for the rest
      for (let i = 1; i < sorted.length; i++) {
        const snapshot = sorted[i];
        // Astro glob loader converts "2026-01-25-17-58.snapshot.mdx" ID to "2026-01-25-17-58snapshot"
        const filename = snapshot.id.split('/')[1];
        const timestamp = filename.replace('snapshot', '');
        paths.push({
          params: { slug: `${slug}/snapshot/${timestamp}` },
          props: { post: snapshot, isSnapshot: true },
        });
      }
    }
  }

  return paths;
}

const { post, isSnapshot } = Astro.props;
const { Content, headings } = await render(post);
const slug = getSlugFromId(post.id);
const snapshots = await getBlogSnapshots(slug);

// MDX component overrides
const components = {
  h1: H1,
  h2: H2,
  h3: H3,
  h4: H4,
  h5: H5,
  h6: H6,
};
---

<BlogPostLayout
  title={post.data.title}
  abstract={post.data.abstract}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt ?? (isSnapshot ? post.data.snapshotDate : undefined)}
  tags={post.data.tags}
  seoTitle={post.data.seoTitle}
  seoDescription={post.data.seoDescription}
  ogImage={post.data.ogImage}
  snapshots={snapshots}
  slug={slug}
  isSnapshot={isSnapshot}
  snapshotDate={isSnapshot ? post.data.snapshotDate : undefined}
  headings={headings}
  tocMaxDepth={post.data.tocMaxDepth}
>
  <Content components={components} />
</BlogPostLayout>
