---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Prose from '@/components/ui/starwind/prose';

export const prerender = true;
---

<BaseLayout
  title="About - Pablo Kvitca"
  description="Learn more about Pablo Kvitca, software engineer and technology enthusiast."
>
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">About Me</h1>

    <Prose class="max-w-none">
      <p>
        I'm a Machine Learning Engineer based in Boston, working on LLM
        training, RLHF, and agentic systems. I'm passionate about building
        great products and solving complex problems across the full stack.
      </p>

      <p>
        This website serves as my personal space on the internet where I share
        my thoughts, projects, and learnings.
      </p>

      <h2>Experience</h2>
      <ul>
        <li>
          <strong>ML Engineer II</strong> at{' '}
          <a href="https://www.amazon.com" target="_blank" rel="noopener noreferrer">Amazon</a>
        </li>
        <li>
          <strong>Data Lake Engineer Intern</strong> at{' '}
          <a href="https://www.paloaltonetworks.com" target="_blank" rel="noopener noreferrer">Palo Alto Networks</a>
        </li>
        <li>
          <strong>Teaching Assistant</strong> at{' '}
          <a href="https://www.khoury.northeastern.edu" target="_blank" rel="noopener noreferrer">Northeastern University</a>
        </li>
        <li>
          <strong>Full Stack Developer</strong> at{' '}
          <a href="https://kovix-group.com/" target="_blank" rel="noopener noreferrer">Kovix Group</a>
        </li>
      </ul>

      <h2>Education</h2>
      <p>
        <strong>BS in Computer Science</strong> with a Concentration in AI from{' '}
        <a href="https://www.khoury.northeastern.edu" target="_blank" rel="noopener noreferrer">
          Northeastern University, Khoury College of Computer Sciences
        </a>
        {' '}&mdash; Graduated with Highest Honors.
      </p>

      <h2>Get in Touch</h2>
      <p>
        The best way to reach me is through{' '}
        <a
          href="https://linkedin.com/in/pablokvitca"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>.
      </p>

      <hr />

      <h2>Publications</h2>
      <ul>
        <li>
          <a href="https://arxiv.org/abs/2307.03306" target="_blank" rel="noopener noreferrer">
            When Fair Classification Meets Noisy Protected Attributes
          </a>
          {' '}&mdash; AIES&apos;23 (arXiv:2307.03306)
        </li>
      </ul>
    </Prose>
  </div>
</BaseLayout>
