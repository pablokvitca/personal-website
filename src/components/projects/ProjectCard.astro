---
import ToolingBadges from '@/components/ui/ToolingBadges.astro';
import { getProjectSlugFromId } from '@/lib/projects';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index } = Astro.props;
const slug = getProjectSlugFromId(project.id);
---

<article class="border border-border rounded-lg p-6 hover:border-primary transition-colors">
  <a href={`/projects/${slug}`} class="block" data-analytics={index !== undefined ? `featured-project-${index + 1}` : `project-card-${slug}`}>
    <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
      <h2 class="text-xl font-semibold hover:text-primary transition-colors">
        {project.data.title}
      </h2>
      <span
        class:list={[
          'text-xs px-2 py-1 rounded-full shrink-0',
          project.data.status === 'active' && 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
          project.data.status === 'completed' && 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
          project.data.status === 'archived' && 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200',
        ]}
      >
        {project.data.status}
      </span>
    </div>
    <p class="text-muted-foreground mb-4 line-clamp-2">
      {project.data.description}
    </p>
  </a>
  <ToolingBadges tags={project.data.tags} />
</article>
