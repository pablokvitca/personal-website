<script>
  import { initPostHog, initPostHogCookieless, refreshTrackingParams } from '@/lib/posthog';
  import { getConsent } from '@/lib/consent';

  function startPostHog() {
    const consent = getConsent();
    if (consent === 'accepted') {
      initPostHog();
    } else {
      // No consent or declined: run cookieless (no persistent identity)
      initPostHogCookieless();
    }
    // Re-register tracking params on every page load — the inline script above
    // has already updated sessionStorage with any new URL params by this point.
    refreshTrackingParams();
  }

  startPostHog();

  window.addEventListener('consent-updated', (e) => {
    const { value } = (e as CustomEvent<{ value: string }>).detail;
    if (value === 'accepted') {
      initPostHog();
    } else {
      initPostHogCookieless();
    }
    // Re-register after re-init (posthog.reset() clears super-properties)
    refreshTrackingParams();
  });
</script>
