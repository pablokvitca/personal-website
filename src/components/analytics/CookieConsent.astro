---
// Rendered server-side but hidden until JS confirms no prior decision
---

<div
  id="cookie-consent-banner"
  class="hidden fixed z-50
         bottom-0 left-0 right-0 rounded-none border-t
         sm:bottom-4 sm:left-auto sm:right-4 sm:max-w-sm sm:rounded-lg sm:border
         border-border bg-background p-4 pb-[calc(1rem+env(safe-area-inset-bottom))] sm:pb-4
         shadow-lg"
  role="dialog"
  aria-modal="true"
  aria-label="Cookie consent"
>
  <p class="text-sm text-foreground font-medium mb-1">Cookie preferences</p>
  <p class="text-sm text-muted-foreground mb-4">
    This site uses analytics to understand how visitors use it. No data is sold or shared with third parties.
  </p>
  <div class="flex gap-2 justify-end">
    <button
      id="cookie-decline"
      class="inline-flex items-center justify-center rounded-md border border-border bg-background px-3 py-1.5 text-sm font-medium text-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
    >
      Decline
    </button>
    <button
      id="cookie-accept"
      class="inline-flex items-center justify-center rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
    >
      Accept
    </button>
  </div>
</div>

<script>
  import { getConsent, setConsent } from '@/lib/consent';

  const banner = document.getElementById('cookie-consent-banner');

  // Show banner only if no prior decision
  if (banner && getConsent() === null) {
    banner.classList.remove('hidden');
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    setConsent('accepted');
    banner?.classList.add('hidden');
  });

  document.getElementById('cookie-decline')?.addEventListener('click', () => {
    setConsent('declined');
    banner?.classList.add('hidden');
  });
</script>
