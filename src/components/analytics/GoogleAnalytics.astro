---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{measurementId && (
  <>
    {/*
      GA Consent Mode v2 (Advanced):
      - The gtag script always loads so GA can do cookieless/modelled measurement
      - consent 'default' is set to denied before gtag('config') fires
      - consent 'update' is called to 'granted' when the user accepts via the banner
      - On subsequent page loads, stored consent is applied before config via the
        inline script below, so GA never fires cookies without consent
    */}
    <script is:inline define:vars={{ measurementId }}>
      // Set up dataLayer and gtag shim before the async script arrives
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }

      // Default all consent types to denied — GA will do cookieless modelling
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });

      // If the user already accepted on a previous visit, upgrade before config fires
      var storedConsent = localStorage.getItem('analytics-consent');
      if (storedConsent === 'accepted') {
        gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
        });
      }

      gtag('js', new Date());

      // Pass ref param as a custom dimension (GA4 handles utm_* natively from URL)
      var gaConfigParams = {};
      try {
        var trackingRaw = sessionStorage.getItem('tracking-params');
        if (trackingRaw) {
          var trackingData = JSON.parse(trackingRaw);
          if (trackingData && typeof trackingData.ref === 'string' && trackingData.ref) {
            gaConfigParams.ref = trackingData.ref;
          }
        }
      } catch (_e) {}

      gtag('config', measurementId, gaConfigParams);
    </script>
    <script
      type="text/partytown"
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
    />

    <script>
      // Grant/revoke consent when the user interacts with the banner (same-page)
      window.addEventListener('consent-updated', (e) => {
        const { value } = (e as CustomEvent<{ value: string }>).detail;
        const state = value === 'accepted' ? 'granted' : 'denied';
        window.gtag?.('consent', 'update', {
          analytics_storage: state,
          ad_storage: state,
          ad_user_data: state,
          ad_personalization: state,
        });
      });
    </script>
  </>
)}
