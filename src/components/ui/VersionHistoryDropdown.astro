---
import { formatDate } from '@/lib/blog';

interface VersionSnapshot {
  url: string;
  date: Date;
}

interface Props {
  currentVersion: number;
  totalVersions: number;
  snapshots: VersionSnapshot[];
  slug: string;
  basePath: string;
}

const { currentVersion, totalVersions, snapshots, slug, basePath } = Astro.props;
---

<details class="version-history-container">
  <summary class="version-button">
    Version {currentVersion}/{totalVersions}
  </summary>

  <div class="version-dropdown-content">
    <a href={`${basePath}/${slug}`} class="version-item">
      <div class="version-label">Current version</div>
      <div class="version-date">Live</div>
    </a>
    <div class="version-divider"></div>
    {snapshots.map((snapshot, index) => (
      <>
        <a href={snapshot.url} class="version-item">
          <div class="version-label">Version {totalVersions - index - 1}</div>
          <div class="version-date">{formatDate(snapshot.date)}</div>
        </a>
        {index < snapshots.length - 1 && <div class="version-divider"></div>}
      </>
    ))}
  </div>
</details>

<style>
  .version-history-container {
    position: relative;
    display: inline-block;
  }

  .version-button {
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
    text-decoration: underline;
    text-decoration-style: dotted;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    transition: color 0.2s;
    list-style: none;
  }

  .version-button::-webkit-details-marker {
    display: none;
  }

  .version-button:hover {
    color: var(--color-primary);
  }

  .version-dropdown-content {
    position: absolute;
    left: 0;
    top: calc(100% + 0.25rem);
    z-index: 50;
    min-width: 200px;
    max-width: calc(100vw - 2rem);
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-card);
    padding: 0.5rem;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.3), 0 4px 6px -4px rgb(0 0 0 / 0.2);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .version-item {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    border-radius: 0.25rem;
    transition: background-color 0.2s;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .version-item:hover {
    background-color: var(--color-accent);
  }

  .version-label {
    font-weight: 500;
  }

  .version-date {
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
  }

  .version-divider {
    border-top: 2px solid var(--color-border);
    margin: 0.375rem 0;
    opacity: 0.5;
  }
</style>
