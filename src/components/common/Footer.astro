---
import ArcjetIcon from '@/components/icons/ArcjetIcon.astro';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border mt-auto">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-muted-foreground">
        &copy; {currentYear} Pablo Kvitca. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="https://linkedin.com/in/pablokvitca"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-muted-foreground hover:text-primary transition-colors"
          data-analytics="footer-linkedin"
        >
          LinkedIn
        </a>
        <a
          href="/colophon"
          class="text-sm text-muted-foreground hover:text-primary transition-colors"
          data-analytics="footer-colophon"
        >
          Colophon
        </a>
        <button
          id="footer-cookie-preferences"
          class="text-sm text-muted-foreground hover:text-primary transition-colors bg-transparent border-none p-0 cursor-pointer"
        >
          Cookie preferences
        </button>
      </div>
    </div>
    <div class="flex justify-center pt-4 border-t border-border/50">
      <a
        href="https://arcjet.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-xs text-muted-foreground/70 hover:text-muted-foreground transition-colors"
        data-analytics="footer-arcjet-badge"
      >
        Protected by Arcjet
        <ArcjetIcon class="size-3.5" />
      </a>
    </div>
  </div>
</footer>

<script>
  import { clearConsent } from '@/lib/consent';

  document.getElementById('footer-cookie-preferences')?.addEventListener('click', () => {
    clearConsent();
    window.location.reload();
  });
</script>
